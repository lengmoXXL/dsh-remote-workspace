# Dependencies
node_modules/

# Build outputs. The store installs this plugin from a pinned commit, so the
# built JavaScript has to be in the source history; source maps do not.
lib/*.map

# Cargo build outputs. The plugin installs the published release binary on the
# remote machine, so nothing built here belongs in the source history.
target/

# Local noise
*.log
.DS_Store

# Browser test screenshots
.artifacts/
