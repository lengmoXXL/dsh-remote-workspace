# Dependencies
node_modules/

# Build outputs. The package is distributed through npm, which builds the
# published tarball from these sources, so neither the bundles nor their maps
# belong in the source history. A checkout builds them through the `prepare`
# script that `npm install` runs.
lib/

# Cargo build outputs. The plugin installs the published release binary on the
# remote machine, so nothing built here belongs in the source history.
target/

# Local noise
*.log
.DS_Store

# Browser test screenshots
.artifacts/
